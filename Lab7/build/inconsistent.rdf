  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#capacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">місткість</rdfs:label>
    <rdfs:comment xml:lang="uk">Максимальна кількість пасажирів транспортного засобу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Route_31">
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#TramRoute"/>
    <mm:hasTrip rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip_31_0700"/>
    <mm:routeId>31</mm:routeId>
    <mm:routeType rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</mm:routeType>
    <mm:servesStop rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop_Rynok"/>
    <mm:servesStop rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop_Vokzal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#datasetDescribes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">описує мережу</rdfs:label>
    <rdfs:comment xml:lang="uk">Джерело даних описує транспортну мережу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#describedByDataset"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7352fd556d0d4de3bff35a060e36e645">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N9480787f8aff4e4cad200eaf6c8587c6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#RouteShape">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Форма маршруту</rdfs:label>
    <dcterms:source>GTFS shapes.txt</dcterms:source>
    <rdfs:comment xml:lang="uk">Геометрія шляху руху транспортного засобу, подана послідовністю координат.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#StopTime_T9_Rynok">
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#StopTime"/>
    <mm:atStop rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop_Rynok"/>
    <mm:departureTime>08:20:00</mm:departureTime>
    <mm:stopSequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</mm:stopSequence>
    <mm:stopTimeOfTrip rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip_9_0800"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#PassengerFlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Пасажиропотік</rdfs:label>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:comment xml:lang="uk">Вимірювання кількості пасажирів, що проходять через зупинку або ділянку за одиницю часу.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#AccessibleStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Доступна зупинка</rdfs:label>
    <dcterms:source>GTFS stops.txt; schema:BusStop</dcterms:source>
    <rdfs:comment xml:lang="uk">Зупинка, обладнана для посадки та висадки маломобільних пасажирів, зокрема з ознакою доступності.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:equivalentClass rdf:nodeID="Nb65c7d50ad7b48d2b5a0fed86f9d6520"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#operatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">виконується перевізником</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс виконується транспортним перевізником.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportAgency"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#operatesTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#drivesTrip">
