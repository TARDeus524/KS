>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#confidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">впевненість прогнозу</rdfs:label>
    <rdfs:comment xml:lang="uk">Оцінка достовірності прогнозу від 0 до 1.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Розклад</rdfs:label>
    <dcterms:source>GTFS calendar.txt, frequencies.txt</dcterms:source>
    <rdfs:comment xml:lang="uk">План виконання рейсів, що визначає дати, часи та інтервали руху на маршрутах.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має вимірювання</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс має кількісні вимірювання затримки, завантаженості або часу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#measurementOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne524eced3f654b6a9d77e0e1a7f7a7c6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:onProperty rdf:resource="https://knowledge.uni.lviv.ua/mobility#atStop"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#CrowdedState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Стан перевантаження</rdfs:label>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:comment xml:lang="uk">Стан рейсу, за якого завантаженість перевищує допустимий рівень комфорту.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#describedByDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">описана джерелом</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортна мережа описана конкретним джерелом даних.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#datasetDescribes"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#GPSTracker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">GPS-трекер</rdfs:label>
    <dcterms:source>ЛР6; GTFS realtime</dcterms:source>
    <rdfs:comment xml:lang="uk">Сенсор, що визначає координати, швидкість і час руху транспортного засобу.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#forecastFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">прогнозує рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Прогноз стосується конкретного рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#forecastOfTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#sensorId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">ідентифікатор сенсора</rdfs:label>
    <rdfs:comment xml:lang="uk">Унікальний ідентифікатор пристрою вимірювання.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Транспортна система</rdfs:label>
    <dcterms:source>ЛР4, ЛР6; GTFS Reference 2026</dcterms:source>
    <rdfs:comment xml:lang="uk">Система, що об’єднує транспортну мережу, рухомий склад, рейси, учасників і управлінські процеси міста.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#MobilitySystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#State_OnTime_9_0830">
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#OnTimeState"/>
    <mm:stateOfTrip rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip_9_0830"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#InterchangeStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Пересадочна зупинка</rdfs:label>
    <dcterms:source>ЛР4, ЛР6; GTFS transfers.txt</dcterms:source>
    <rdfs:comment xml:lang="uk">Зупинка, яку обслуговують щонайменше два різні транспортні маршрути і на якій можлива пересадка.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://schema.org/BusStop"/>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:equivalentClass rdf:nodeID="N567e2e694cd544ef982544e1a87e0da1"/>
    <skos:closeMatch rdf:resource="https://schema.org/BusStop"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportAgency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Перевізник</rdfs:label>
    <dcterms:source>GTFS agency.txt; schema:Organization</dcterms:source>
    <rdfs:comment xml:lang="uk">Організація, що надає транспортні послуги, володіє рухомим складом і публікує дані.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://schema.org/Organization"/>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
    <skos:closeMatch rdf:resource="https://schema.org/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Stop_Politekhnika">
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <mm:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">49.8355</mm:latitude>
    <mm:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.012</mm:longitude>
    <mm:servedByRoute rdf:resource="https://knowledge.uni.lviv.ua/mobility#Route_9"/>
    <mm:stopId>S003</mm:stopId>
    <mm:stopName>Політехніка</mm:stopName>
    <mm:wheelchairAccessible rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mm:wheelchairAccessible>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#servesStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">обслуговує зупинку</rdfs:label>
    <rdfs:comment xml:lang="uk">Маршрут обслуговує зупинку, на якій зупиняються його рейси.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#servedByRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#PassengerSurge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Сплеск пасажиропотоку</rdfs:label>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:comment xml:lang="uk">Подія, за якої попит на перевезення різко перевищує плановий пасажиропотік.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#respondsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">реагує на подію</rdfs:label>
    <rdfs:comment xml:lang="uk">Диспетчер реагує на подію в реальному часі.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Dispatcher"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#handledBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#stopId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">ідентифікатор зупинки</rdfs:label>
    <rdfs:comment xml:lang="uk">Унікальний ідентифікатор зупинки з GTFS stops.txt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TramRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Трамвайний маршрут</rdfs:label>
    <dcterms:source>GTFS routes.txt</dcterms:source>
    <rdfs:comment xml:lang="uk">Транспортний маршрут, що обслуговується трамваями і має GTFS route_type = 0.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Маршрут містить конкретні рейси, що його виконують.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#tripOfRoute"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6095eacb99bb410fb173ada174c84094">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <owl:onProperty rdf:resource="https://knowledge.uni.lviv.ua/mobility#servedByRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#longitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">довгота</rdfs:label>
    <rdfs:comment xml:lang="uk">Географічна довгота зупинки в градусах.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#usesVehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">використовує транспортний засіб</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс виконується конкретним транспортним засобом.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#assignedToTrip"/>
  </rdf:Description>
