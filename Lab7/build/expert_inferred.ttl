@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://knowledge.uni.lviv.ua/mobility#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://knowledge.uni.lviv.ua/mobility> a owl:Ontology ;
    dcterms:creator "Невмержицький Максим Миколайович" ;
    dcterms:title "Онтологія інтелектуального управління міською мобільністю"@uk ;
    rdfs:seeAlso schema: ;
    owl:versionInfo "1.0" .

ns1:Calendar_2026 a ns1:MobilitySystem,
        ns1:Schedule,
        ns1:ServiceCalendar,
        ns1:TransportSystem ;
    rdfs:label "Будні 2026"@uk ;
    ns1:validFrom "2026-01-01" ;
    ns1:validTo "2026-12-31" .

ns1:DispatchDecision a owl:Class ;
    rdfs:label "Диспетчерське рішення"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Аналітичний результат, що визначає управлінську дію диспетчера на подію або відхилення від розкладу."@uk ;
    rdfs:subClassOf ns1:Analytics .

ns1:Fare a owl:Class ;
    rdfs:label "Тариф"@uk ;
    dcterms:source "GTFS fare_attributes.txt" ;
    rdfs:comment "Правила та вартість оплати проїзду, що застосовуються до маршрутів або поїздок."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Passenger_P02 a ns1:Actor,
        ns1:MobilitySystem,
        ns1:Passenger,
        ns1:TransportSystem ;
    ns1:personName "Софія Бондар" .

ns1:RouteShape a owl:Class ;
    rdfs:label "Форма маршруту"@uk ;
    dcterms:source "GTFS shapes.txt" ;
    rdfs:comment "Геометрія шляху руху транспортного засобу, подана послідовністю координат."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Trolleybus_1101 a ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Trolleybus,
        ns1:Vehicle ;
    ns1:capacity 110 ;
    ns1:vehicleId "TB1101" .

ns1:agencyName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "назва перевізника"@uk ;
    rdfs:comment "Офіційна назва транспортного перевізника."@uk ;
    rdfs:domain ns1:TransportAgency ;
    rdfs:range xsd:string .

ns1:capacity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "місткість"@uk ;
    rdfs:comment "Максимальна кількість пасажирів транспортного засобу."@uk ;
    rdfs:domain ns1:Vehicle ;
    rdfs:range xsd:integer .

ns1:confidence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "впевненість прогнозу"@uk ;
    rdfs:comment "Оцінка достовірності прогнозу від 0 до 1."@uk ;
    rdfs:domain ns1:Forecast ;
    rdfs:range xsd:decimal .

ns1:datasetName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "назва набору даних"@uk ;
    rdfs:comment "Людиночитана назва джерела даних."@uk ;
    rdfs:domain ns1:DataAsset ;
    rdfs:range xsd:string .

ns1:delayMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "затримка, хв"@uk ;
    rdfs:comment "Відхилення фактичного часу відправлення від планового в хвилинах."@uk ;
    rdfs:domain ns1:Delay ;
    rdfs:range xsd:integer .

ns1:departureTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "час відправлення"@uk ;
    rdfs:comment "Плановий час відправлення рейсу з зупинки."@uk ;
    rdfs:domain ns1:StopTime ;
    rdfs:range xsd:string .

ns1:eventTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "час події"@uk ;
    rdfs:comment "Дата й час виникнення події на мережі."@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:dateTime .

ns1:headwayMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "інтервал, хв"@uk ;
    rdfs:comment "Проміжок між послідовними відправленнями рейсів у хвилинах."@uk ;
    rdfs:domain ns1:Frequency ;
    rdfs:range xsd:integer .

ns1:interchangesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "має пересадку з"@uk ;
    rdfs:comment "Симетричне відношення між зупинками, між якими можлива пересадка."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range ns1:Stop .

ns1:latitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "широта"@uk ;
    rdfs:comment "Географічна широта зупинки в градусах."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range xsd:decimal .

ns1:loadFactor a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "коефіцієнт завантаженості"@uk ;
    rdfs:comment "Відношення кількості пасажирів до місткості транспортного засобу."@uk ;
    rdfs:domain ns1:LoadFactor ;
    rdfs:range xsd:decimal .

ns1:locatedAt a owl:ObjectProperty ;
    rdfs:label "розташована в"@uk ;
    rdfs:comment "Зупинка розташована в місці, поданому зовнішнім словником Schema.org."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range schema:Place .

ns1:longitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "довгота"@uk ;
    rdfs:comment "Географічна довгота зупинки в градусах."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range xsd:decimal .

ns1:passengerCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "кількість пасажирів"@uk ;
    rdfs:comment "Кількість валідованих пасажирів за інтервал спостереження."@uk ;
    rdfs:domain ns1:PassengerFlow ;
    rdfs:range xsd:integer .

ns1:personName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ім’я учасника"@uk ;
    rdfs:comment "Людиночитане ім’я пасажира, водія або диспетчера."@uk ;
    rdfs:domain ns1:Actor ;
    rdfs:range xsd:string .

ns1:routeId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ідентифікатор маршруту"@uk ;
    rdfs:comment "Унікальний ідентифікатор маршруту з GTFS routes.txt."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range xsd:string .

ns1:routeType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "тип маршруту"@uk ;
    rdfs:comment "Код виду транспорту GTFS: 3 — автобус, 0 — трамвай, 11 — тролейбус."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range xsd:integer .

ns1:sensorId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ідентифікатор сенсора"@uk ;
    rdfs:comment "Унікальний ідентифікатор пристрою вимірювання."@uk ;
    rdfs:domain ns1:Sensor ;
    rdfs:range xsd:string .

ns1:stopId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ідентифікатор зупинки"@uk ;
    rdfs:comment "Унікальний ідентифікатор зупинки з GTFS stops.txt."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range xsd:string .

ns1:stopName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "назва зупинки"@uk ;
    rdfs:comment "Людиночитана назва зупинки."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range xsd:string .

ns1:stopSequence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "порядковий номер зупинки"@uk ;
    rdfs:comment "Номер зупинки в послідовності рейсу."@uk ;
    rdfs:domain ns1:StopTime ;
    rdfs:range xsd:integer .

ns1:travelTimeMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "час у дорозі, хв"@uk ;
    rdfs:comment "Тривалість проходження ділянки або рейсу в хвилинах."@uk ;
    rdfs:domain ns1:TravelTime ;
    rdfs:range xsd:integer .

ns1:tripId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ідентифікатор рейсу"@uk ;
    rdfs:comment "Унікальний ідентифікатор рейсу з GTFS trips.txt."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range xsd:string .

ns1:validFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "дійсний від"@uk ;
    rdfs:comment "Перша дата дії календаря обслуговування."@uk ;
    rdfs:domain ns1:ServiceCalendar ;
    rdfs:range xsd:string .

ns1:validTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "дійсний до"@uk ;
    rdfs:comment "Остання дата дії календаря обслуговування."@uk ;
    rdfs:domain ns1:ServiceCalendar ;
    rdfs:range xsd:string .

ns1:vehicleId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ідентифікатор транспортного засобу"@uk ;
    rdfs:comment "Унікальний ідентифікатор рухомого складу."@uk ;
    rdfs:domain ns1:Vehicle ;
    rdfs:range xsd:string .

<https://knowledge.uni.lviv.ua/mobility/data> owl:versionInfo "1.0" .

ns1:Agency_LvivElektrotrans a ns1:Actor,
        ns1:MobilitySystem,
        ns1:TransportAgency,
        ns1:TransportSystem ;
    ns1:agencyName "ЛьвівЕлектротранс" ;
    ns1:operatesTrip ns1:Trip_31_0700 .

ns1:Bus_2501 a ns1:Bus,
        ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Vehicle ;
    ns1:assignedToTrip ns1:Trip_9_0800 ;
    ns1:capacity 90 ;
    ns1:vehicleId "B2501" .

ns1:CongestedSegment a owl:Class ;
    rdfs:label "Завантажена ділянка"@uk ;
    dcterms:source "ЛР6; GTFS Reference 2026" ;
    rdfs:comment "Ділянка мережі, на якій зафіксовано подію затору, що впливає на час руху."@uk ;
    rdfs:subClassOf ns1:NetworkSegment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:NetworkSegment [ a owl:Restriction ;
                        owl:onProperty ns1:hasEvent ;
                        owl:someValuesFrom ns1:Congestion ] ) ] .

ns1:Counter_2501 a ns1:DataAsset,
        ns1:MobilitySystem,
        ns1:PassengerCounter,
        ns1:Sensor,
        ns1:TransportSystem ;
    ns1:measures ns1:Load_9_0800 ;
    ns1:sensorId "CNT-2501" .

ns1:CrowdedState a owl:Class ;
    rdfs:label "Стан перевантаження"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Стан рейсу, за якого завантаженість перевищує допустимий рівень комфорту."@uk ;
    rdfs:subClassOf ns1:TransportState .

ns1:DelayedTrip a owl:Class ;
    rdfs:label "Затриманий рейс"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Рейс, фактичний стан якого відхилено від розкладу щонайменше на порогову величину затримки."@uk ;
    rdfs:subClassOf ns1:Trip ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Trip [ a owl:Restriction ;
                        owl:onProperty ns1:hasState ;
                        owl:someValuesFrom ns1:DelayedState ] ) ] .

ns1:Dispatcher_01 a ns1:Actor,
        ns1:Dispatcher,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:personName "Марія Шевчук" ;
    ns1:respondsTo ns1:Congestion_Horodotska .

ns1:Driver_01 a ns1:Actor,
        ns1:Driver,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:drivesTrip ns1:Trip_9_0800 ;
    ns1:personName "Іван Петренко" .

ns1:Driver_02 a ns1:Actor,
        ns1:Driver,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:drivesTrip ns1:Trip_31_0700 ;
    ns1:personName "Олена Коваль" .

ns1:Flow_Vokzal_0800 a ns1:Measurement,
        ns1:MobilitySystem,
        ns1:PassengerFlow,
        ns1:TransportSystem ;
    ns1:measuredBy ns1:Validator_Vokzal ;
    ns1:passengerCount 120 .

ns1:Frequency_R25 a ns1:Frequency,
        ns1:MobilitySystem,
        ns1:Schedule,
        ns1:TransportSystem ;
    ns1:frequencyOfRoute ns1:Route_25 ;
    ns1:headwayMinutes 15 .

ns1:Frequency_R9 a ns1:Frequency,
        ns1:MobilitySystem,
        ns1:Schedule,
        ns1:TransportSystem ;
    ns1:frequencyOfRoute ns1:Route_9 ;
    ns1:headwayMinutes 10 .

ns1:GPSTracker a owl:Class ;
    rdfs:label "GPS-трекер"@uk ;
    dcterms:source "ЛР6; GTFS realtime" ;
    rdfs:comment "Сенсор, що визначає координати, швидкість і час руху транспортного засобу."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:GTFS_Lviv a ns1:DataAsset,
        ns1:GTFSDataset,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:datasetDescribes ns1:Network_Lviv ;
    ns1:datasetName "GTFS Lviv 2026" .

ns1:NeTEx_Lviv a ns1:DataAsset,
        ns1:MobilitySystem,
        ns1:NeTExDataset,
        ns1:TransportSystem ;
    ns1:datasetDescribes ns1:Network_Lviv ;
    ns1:datasetName "NeTEx Lviv 2026" .

ns1:PassengerCounter a owl:Class ;
    rdfs:label "Лічильник пасажирів"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Сенсор, що вимірює кількість пасажирів у транспортному засобі або на зупинці."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:PassengerSurge a owl:Class ;
    rdfs:label "Сплеск пасажиропотоку"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Подія, за якої попит на перевезення різко перевищує плановий пасажиропотік."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:Passenger_P01 a ns1:Actor,
        ns1:MobilitySystem,
        ns1:Passenger,
        ns1:TransportSystem ;
    ns1:passengerRecommendation ns1:Recommendation_R1 ;
    ns1:personName "Андрій Мельник" .

ns1:Roadwork_Stryiska a ns1:Event,
        ns1:MobilitySystem,
        ns1:Roadwork,
        ns1:TransportSystem ;
    ns1:affectsSegment ns1:Seg_Rynok_Politekhnika ;
    ns1:eventTime "2026-10-27T07:00:00"^^xsd:dateTime .

ns1:SIRI_Lviv a ns1:DataAsset,
        ns1:MobilitySystem,
        ns1:SIRIFeed,
        ns1:TransportSystem ;
    ns1:datasetDescribes ns1:Network_Lviv ;
    ns1:datasetName "SIRI Lviv realtime" .

ns1:Seg_Rynok_Politekhnika a ns1:MobilitySystem,
        ns1:NetworkSegment,
        ns1:TransportNetwork,
        ns1:TransportSystem ;
    rdfs:label "Площа Ринок — Політехніка"@uk ;
    ns1:hasEvent ns1:Roadwork_Stryiska .

ns1:Seg_Vokzal_Rynok a ns1:CongestedSegment,
        ns1:MobilitySystem,
        ns1:NetworkSegment,
        ns1:TransportNetwork,
        ns1:TransportSystem ;
    rdfs:label "Вокзал — Площа Ринок"@uk ;
    ns1:hasEvent ns1:Congestion_Horodotska .

ns1:State_Delayed_9 a ns1:DelayedState,
        ns1:MobilitySystem,
        ns1:TransportState,
        ns1:TransportSystem ;
    ns1:stateOfTrip ns1:Trip_9_0800 .

ns1:State_OnTime_25 a ns1:MobilitySystem,
        ns1:OnTimeState,
        ns1:TransportState,
        ns1:TransportSystem ;
    ns1:stateOfTrip ns1:Trip_25_0815 .

ns1:State_OnTime_31 a ns1:MobilitySystem,
        ns1:OnTimeState,
        ns1:TransportState,
        ns1:TransportSystem ;
    ns1:stateOfTrip ns1:Trip_31_0700 .

ns1:State_OnTime_9_0830 a ns1:MobilitySystem,
        ns1:OnTimeState,
        ns1:TransportState,
        ns1:TransportSystem ;
    ns1:stateOfTrip ns1:Trip_9_0830 .

ns1:System_Lviv a ns1:MobilitySystem,
        ns1:TransportSystem ;
    rdfs:label "Транспортна система Львова"@uk ;
    ns1:hasPart ns1:Network_Lviv .

ns1:TicketValidator a owl:Class ;
    rdfs:label "Валідатор квитків"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Сенсор, що фіксує факти валідації квитків і посадки пасажирів на зупинці."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:Tram_0903 a ns1:MobilitySystem,
        ns1:Tram,
        ns1:TransportSystem,
        ns1:Vehicle ;
    ns1:assignedToTrip ns1:Trip_31_0700 ;
    ns1:capacity 180 ;
    ns1:vehicleId "T0903" .

ns1:TrolleybusRoute a owl:Class ;
    rdfs:label "Тролейбусний маршрут"@uk ;
    dcterms:source "GTFS routes.txt" ;
    rdfs:comment "Транспортний маршрут, що обслуговується тролейбусами і має GTFS route_type = 11."@uk ;
    rdfs:subClassOf ns1:TransportRoute .

ns1:Validator_Vokzal a ns1:DataAsset,
        ns1:MobilitySystem,
        ns1:Sensor,
        ns1:TicketValidator,
        ns1:TransportSystem ;
    ns1:measures ns1:Flow_Vokzal_0800 ;
    ns1:sensorId "VAL-S001" .

ns1:VehicleFailure a owl:Class ;
    rdfs:label "Поломка транспортного засобу"@uk ;
    dcterms:source "SIRI; ЛР6" ;
    rdfs:comment "Подія, за якої транспортний засіб не може продовжити виконання рейсу без заміни."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:WeatherEvent a owl:Class ;
    rdfs:label "Погіршення погоди"@uk ;
    dcterms:source "SIRI; ЛР6" ;
    rdfs:comment "Подія, за якої погодні умови знижують швидкість або надійність руху транспорту."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:affectedByEvent a owl:ObjectProperty ;
    rdfs:label "зазнає впливу події"@uk ;
    rdfs:comment "Рейс зазнає впливу події на мережі."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Event ;
    owl:inverseOf ns1:affectsTrip .

ns1:affectsSegment a owl:ObjectProperty ;
    rdfs:label "впливає на ділянку"@uk ;
    rdfs:comment "Подія впливає на конкретну ділянку транспортної мережі."@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range ns1:NetworkSegment ;
    owl:inverseOf ns1:hasEvent .

ns1:affectsTrip a owl:ObjectProperty ;
    rdfs:label "впливає на рейс"@uk ;
    rdfs:comment "Подія спричиняє зміну виконання конкретного рейсу."@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:affectedByEvent .

ns1:assignedToTrip a owl:ObjectProperty ;
    rdfs:label "призначений на рейс"@uk ;
    rdfs:comment "Транспортний засіб призначено на виконання рейсу."@uk ;
    rdfs:domain ns1:Vehicle ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:usesVehicle .

ns1:basedOnForecast a owl:ObjectProperty ;
    rdfs:label "ґрунтується на прогнозі"@uk ;
    rdfs:comment "Рішення використовує конкретний прогноз."@uk ;
    rdfs:domain ns1:DecisionSupport ;
    rdfs:range ns1:Forecast ;
    owl:inverseOf ns1:supportsDecision .

ns1:datasetDescribes a owl:ObjectProperty ;
    rdfs:label "описує мережу"@uk ;
    rdfs:comment "Джерело даних описує транспортну мережу."@uk ;
    rdfs:domain ns1:DataAsset ;
    rdfs:range ns1:TransportNetwork ;
    owl:inverseOf ns1:describedByDataset .

ns1:describedByDataset a owl:ObjectProperty ;
    rdfs:label "описана джерелом"@uk ;
    rdfs:comment "Транспортна мережа описана конкретним джерелом даних."@uk ;
    rdfs:domain ns1:TransportNetwork ;
    rdfs:range ns1:DataAsset ;
    owl:inverseOf ns1:datasetDescribes .

ns1:drivesTrip a owl:ObjectProperty ;
    rdfs:label "керує рейсом"@uk ;
    rdfs:comment "Водій виконує конкретний рейс."@uk ;
    rdfs:domain ns1:Driver ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:hasDriver .

ns1:endsAt a owl:ObjectProperty ;
    rdfs:label "завершується на"@uk ;
    rdfs:comment "Рейс завершується на заданій зупинці."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Stop ;
    owl:inverseOf ns1:isEndOf .

ns1:forPassenger a owl:ObjectProperty ;
    rdfs:label "призначена пасажиру"@uk ;
    rdfs:comment "Рекомендація адресована конкретному пасажиру."@uk ;
    rdfs:domain ns1:Recommendation ;
    rdfs:range ns1:Passenger ;
    owl:inverseOf ns1:passengerRecommendation .

ns1:forecastOfTrip a owl:ObjectProperty ;
    rdfs:label "має прогноз"@uk ;
    rdfs:comment "Рейс має прогнозне значення."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Forecast ;
    owl:inverseOf ns1:forecastFor .

ns1:frequencyOfRoute a owl:ObjectProperty ;
    rdfs:label "є інтервалом маршруту"@uk ;
    rdfs:comment "Запис інтервалу руху належить конкретному маршруту."@uk ;
    rdfs:domain ns1:Frequency ;
    rdfs:range ns1:TransportRoute ;
    owl:inverseOf ns1:routeFrequency .

ns1:handledBy a owl:ObjectProperty ;
    rdfs:label "опрацьована диспетчером"@uk ;
    rdfs:comment "Подія опрацьована конкретним диспетчером."@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range ns1:Dispatcher ;
    owl:inverseOf ns1:respondsTo .

ns1:hasDriver a owl:ObjectProperty ;
    rdfs:label "має водія"@uk ;
    rdfs:comment "Рейс обслуговує конкретний водій."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Driver ;
    owl:inverseOf ns1:drivesTrip .

ns1:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "має вимірювання"@uk ;
    rdfs:comment "Рейс має кількісні вимірювання затримки, завантаженості або часу."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Measurement ;
    owl:inverseOf ns1:measurementOf .

ns1:hasPart a owl:ObjectProperty ;
    rdfs:label "містить"@uk ;
    rdfs:comment "Відношення ціле-частина між елементами предметної області."@uk ;
    rdfs:domain ns1:MobilitySystem ;
    rdfs:range ns1:MobilitySystem ;
    owl:inverseOf ns1:partOf .

ns1:hasRecommendation a owl:ObjectProperty ;
    rdfs:label "має рекомендацію"@uk ;
    rdfs:comment "Рішення породжує конкретну рекомендацію."@uk ;
    rdfs:domain ns1:DecisionSupport ;
    rdfs:range ns1:Recommendation ;
    owl:inverseOf ns1:recommendationOfDecision .

ns1:hasTrip a owl:ObjectProperty ;
    rdfs:label "має рейс"@uk ;
    rdfs:comment "Маршрут містить конкретні рейси, що його виконують."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:tripOfRoute .

ns1:isEndOf a owl:ObjectProperty ;
    rdfs:label "є завершенням"@uk ;
    rdfs:comment "Зупинка є кінцевою для рейсу."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:endsAt .

ns1:isStartOf a owl:ObjectProperty ;
    rdfs:label "є початком"@uk ;
    rdfs:comment "Зупинка є початковою для рейсу."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:startsAt .

ns1:measuredBy a owl:ObjectProperty ;
    rdfs:label "виміряне сенсором"@uk ;
    rdfs:comment "Вимірювання отримане конкретним сенсором."@uk ;
    rdfs:domain ns1:Measurement ;
    rdfs:range ns1:Sensor ;
    owl:inverseOf ns1:measures .

ns1:measurementOf a owl:ObjectProperty ;
    rdfs:label "є вимірюванням"@uk ;
    rdfs:comment "Вимірювання стосується конкретного рейсу."@uk ;
    rdfs:domain ns1:Measurement ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:hasMeasurement .

ns1:measures a owl:ObjectProperty ;
    rdfs:label "вимірює"@uk ;
    rdfs:comment "Сенсор формує конкретне вимірювання."@uk ;
    rdfs:domain ns1:Sensor ;
    rdfs:range ns1:Measurement ;
    owl:inverseOf ns1:measuredBy .

ns1:operatesTrip a owl:ObjectProperty ;
    rdfs:label "виконує рейс"@uk ;
    rdfs:comment "Перевізник виконує конкретний рейс."@uk ;
    rdfs:domain ns1:TransportAgency ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:operatedBy .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "є частиною"@uk ;
    rdfs:comment "Обернене до hasPart транзитивне відношення належності цілому."@uk ;
    rdfs:domain ns1:MobilitySystem ;
    rdfs:range ns1:MobilitySystem ;
    owl:inverseOf ns1:hasPart .

ns1:passengerRecommendation a owl:ObjectProperty ;
    rdfs:label "має рекомендацію"@uk ;
    rdfs:comment "Пасажир отримує конкретну рекомендацію."@uk ;
    rdfs:domain ns1:Passenger ;
    rdfs:range ns1:Recommendation ;
    owl:inverseOf ns1:forPassenger .

ns1:recommendationOfDecision a owl:ObjectProperty ;
    rdfs:label "є рекомендацією рішення"@uk ;
    rdfs:comment "Рекомендація походить від управлінського рішення."@uk ;
    rdfs:domain ns1:Recommendation ;
    rdfs:range ns1:DecisionSupport ;
    owl:inverseOf ns1:hasRecommendation .

ns1:recommendedBy a owl:ObjectProperty ;
    rdfs:label "рекомендований"@uk ;
    rdfs:comment "Маршрут пропонується рекомендацією."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range ns1:Recommendation ;
    owl:inverseOf ns1:recommends .

ns1:respondsTo a owl:ObjectProperty ;
    rdfs:label "реагує на подію"@uk ;
    rdfs:comment "Диспетчер реагує на подію в реальному часі."@uk ;
    rdfs:domain ns1:Dispatcher ;
    rdfs:range ns1:Event ;
    owl:inverseOf ns1:handledBy .

ns1:routeFrequency a owl:ObjectProperty ;
    rdfs:label "має інтервал"@uk ;
    rdfs:comment "Маршрут має заданий інтервал руху."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range ns1:Frequency ;
    owl:inverseOf ns1:frequencyOfRoute .

ns1:startsAt a owl:ObjectProperty ;
    rdfs:label "починається на"@uk ;
    rdfs:comment "Рейс починається на заданій зупинці."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Stop ;
    owl:inverseOf ns1:isStartOf .

ns1:stateOfTrip a owl:ObjectProperty ;
    rdfs:label "є станом рейсу"@uk ;
    rdfs:comment "Стан описує конкретний рейс."@uk ;
    rdfs:domain ns1:TransportState ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:hasState .

ns1:stopAtTime a owl:ObjectProperty ;
    rdfs:label "має запис часу"@uk ;
    rdfs:comment "Зупинка має записи часу прибуття та відправлення."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range ns1:StopTime ;
    owl:inverseOf ns1:atStop .

ns1:stopTimeOfTrip a owl:ObjectProperty ;
    rdfs:label "є часом рейсу"@uk ;
    rdfs:comment "Запис часу зупинки належить конкретному рейсу."@uk ;
    rdfs:domain ns1:StopTime ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:hasStopTime .

ns1:supportsDecision a owl:ObjectProperty ;
    rdfs:label "підтримує рішення"@uk ;
    rdfs:comment "Прогноз є підставою для управлінського рішення."@uk ;
    rdfs:domain ns1:Forecast ;
    rdfs:range ns1:DecisionSupport ;
    owl:inverseOf ns1:basedOnForecast .

ns1:tripOfRoute a owl:ObjectProperty ;
    rdfs:label "є рейсом маршруту"@uk ;
    rdfs:comment "Рейс належить транспортному маршруту."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:TransportRoute ;
    owl:inverseOf ns1:hasTrip .

ns1:wheelchairAccessible a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "доступність"@uk ;
    rdfs:comment "Ознака доступності зупинки для маломобільних пасажирів."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range xsd:boolean .

ns1:AccessibleStop a owl:Class ;
    rdfs:label "Доступна зупинка"@uk ;
    dcterms:source "GTFS stops.txt; schema:BusStop" ;
    rdfs:comment "Зупинка, обладнана для посадки та висадки маломобільних пасажирів, зокрема з ознакою доступності."@uk ;
    rdfs:subClassOf ns1:Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Stop [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty ns1:wheelchairAccessible ] ) ] .

ns1:Bus_2502 a ns1:Bus,
        ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Vehicle ;
    ns1:assignedToTrip ns1:Trip_25_0815,
        ns1:Trip_9_0830 ;
    ns1:capacity 85 ;
    ns1:vehicleId "B2502" .

ns1:Decision_D1 a ns1:Analytics,
        ns1:DecisionSupport,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:basedOnForecast ns1:Forecast_9_Peak ;
    ns1:hasRecommendation ns1:Recommendation_R1 .

ns1:Delay_9_0800 a ns1:Delay,
        ns1:Measurement,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:delayMinutes 12 ;
    ns1:measuredBy ns1:GPS_2501 ;
    ns1:measurementOf ns1:Trip_9_0800 .

ns1:Forecast_9_Peak a ns1:Analytics,
        ns1:Forecast,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:confidence 0.87 ;
    ns1:forecastFor ns1:Trip_9_0800 ;
    ns1:supportsDecision ns1:Decision_D1 .

ns1:GPS_2501 a ns1:DataAsset,
        ns1:GPSTracker,
        ns1:MobilitySystem,
        ns1:Sensor,
        ns1:TransportSystem ;
    ns1:measures ns1:Delay_9_0800,
        ns1:TravelTime_9_0800 ;
    ns1:sensorId "GPS-2501" .

ns1:GTFSDataset a owl:Class ;
    rdfs:label "Набір GTFS"@uk ;
    dcterms:source "GTFS Reference 2026" ;
    rdfs:comment "Джерело даних, що складається з CSV-файлів GTFS для опису маршрутів, рейсів, зупинок і розкладів."@uk ;
    rdfs:seeAlso schema:Dataset ;
    rdfs:subClassOf ns1:DataAsset ;
    skos:closeMatch schema:Dataset .

ns1:InterchangeStop a owl:Class ;
    rdfs:label "Пересадочна зупинка"@uk ;
    dcterms:source "ЛР4, ЛР6; GTFS transfers.txt" ;
    rdfs:comment "Зупинка, яку обслуговують щонайменше два різні транспортні маршрути і на якій можлива пересадка."@uk ;
    rdfs:seeAlso schema:BusStop ;
    rdfs:subClassOf ns1:Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Stop [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ns1:TransportRoute ;
                        owl:onProperty ns1:servedByRoute ] ) ] ;
    skos:closeMatch schema:BusStop .

ns1:Load_9_0800 a ns1:LoadFactor,
        ns1:Measurement,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:loadFactor 0.92 ;
    ns1:measuredBy ns1:Counter_2501 ;
    ns1:measurementOf ns1:Trip_9_0800 .

ns1:NeTExDataset a owl:Class ;
    rdfs:label "Набір NeTEx"@uk ;
    dcterms:source "NeTEx; Transmodel" ;
    rdfs:comment "Джерело даних, що містить XML-описи мережі, розкладів і тарифів за стандартом NeTEx."@uk ;
    rdfs:subClassOf ns1:DataAsset .

ns1:Roadwork a owl:Class ;
    rdfs:label "Ремонт дороги"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Подія, що тимчасово обмежує пропускну здатність ділянки мережі через ремонтні роботи."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:SIRIFeed a owl:Class ;
    rdfs:label "Потік SIRI"@uk ;
    dcterms:source "SIRI; Transmodel" ;
    rdfs:comment "Джерело даних, що містить повідомлення SIRI про рух транспорту в реальному часі."@uk ;
    rdfs:subClassOf ns1:DataAsset .

