    ns1:stopId "S004" ;
    ns1:stopName "Університет" ;
    ns1:wheelchairAccessible false .

ns1:Tram a owl:Class ;
    rdfs:label "Трамвай"@uk ;
    dcterms:source "GTFS route_type = 0" ;
    rdfs:comment "Рейковий транспортний засіб, що рухається трамвайною колією у міській мережі."@uk ;
    rdfs:subClassOf ns1:Vehicle .

ns1:TramRoute a owl:Class ;
    rdfs:label "Трамвайний маршрут"@uk ;
    dcterms:source "GTFS routes.txt" ;
    rdfs:comment "Транспортний маршрут, що обслуговується трамваями і має GTFS route_type = 0."@uk ;
    rdfs:subClassOf ns1:TransportRoute .

ns1:TravelTime_9_0800 a ns1:Measurement,
        ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:TravelTime ;
    ns1:measuredBy ns1:GPS_2501 ;
    ns1:measurementOf ns1:Trip_9_0800 ;
    ns1:travelTimeMinutes 38 .

ns1:Trolleybus a owl:Class ;
    rdfs:label "Тролейбус"@uk ;
    dcterms:source "GTFS route_type = 11" ;
    rdfs:comment "Транспортний засіб з електроживленням від контактної мережі, що використовується на тролейбусних маршрутах."@uk ;
    rdfs:subClassOf ns1:Vehicle .

ns1:atStop a owl:ObjectProperty ;
    rdfs:label "на зупинці"@uk ;
    rdfs:comment "Запис часу зупинки стосується конкретної зупинки."@uk ;
    rdfs:domain ns1:StopTime ;
    rdfs:range ns1:Stop ;
    owl:inverseOf ns1:stopAtTime .

ns1:forecastFor a owl:ObjectProperty ;
    rdfs:label "прогнозує рейс"@uk ;
    rdfs:comment "Прогноз стосується конкретного рейсу."@uk ;
    rdfs:domain ns1:Forecast ;
    rdfs:range ns1:Trip ;
    owl:inverseOf ns1:forecastOfTrip .

ns1:hasState a owl:ObjectProperty ;
    rdfs:label "має стан"@uk ;
    rdfs:comment "Рейс перебуває в конкретному стані виконання."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:TransportState ;
    owl:inverseOf ns1:stateOfTrip .

ns1:hasStopTime a owl:ObjectProperty ;
    rdfs:label "має зупиночний час"@uk ;
    rdfs:comment "Рейс містить записи часу прибуття та відправлення на зупинках."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:StopTime ;
    owl:inverseOf ns1:stopTimeOfTrip .

ns1:operatedBy a owl:ObjectProperty ;
    rdfs:label "виконується перевізником"@uk ;
    rdfs:comment "Рейс виконується транспортним перевізником."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:TransportAgency ;
    owl:inverseOf ns1:operatesTrip .

ns1:recommends a owl:ObjectProperty ;
    rdfs:label "рекомендує маршрут"@uk ;
    rdfs:comment "Рекомендація пропонує конкретний маршрут."@uk ;
    rdfs:domain ns1:Recommendation ;
    rdfs:range ns1:TransportRoute ;
    owl:inverseOf ns1:recommendedBy .

ns1:servedByRoute a owl:ObjectProperty ;
    rdfs:label "обслуговується маршрутом"@uk ;
    rdfs:comment "Зупинка обслуговується транспортним маршрутом."@uk ;
    rdfs:domain ns1:Stop ;
    rdfs:range ns1:TransportRoute ;
    owl:inverseOf ns1:servesStop .

ns1:servesStop a owl:ObjectProperty ;
    rdfs:label "обслуговує зупинку"@uk ;
    rdfs:comment "Маршрут обслуговує зупинку, на якій зупиняються його рейси."@uk ;
    rdfs:domain ns1:TransportRoute ;
    rdfs:range ns1:Stop ;
    owl:inverseOf ns1:servedByRoute .

ns1:usesVehicle a owl:ObjectProperty ;
    rdfs:label "використовує транспортний засіб"@uk ;
    rdfs:comment "Рейс виконується конкретним транспортним засобом."@uk ;
    rdfs:domain ns1:Trip ;
    rdfs:range ns1:Vehicle ;
    owl:inverseOf ns1:assignedToTrip .

ns1:Agency_LvivAvtobus a ns1:Actor,
        ns1:MobilitySystem,
        ns1:TransportAgency,
        ns1:TransportSystem ;
    ns1:agencyName "ЛьвівАвтобус" ;
    ns1:operatesTrip ns1:Trip_25_0815,
        ns1:Trip_9_0800,
        ns1:Trip_9_0830 .

ns1:Bus a owl:Class ;
    rdfs:label "Автобус"@uk ;
    dcterms:source "GTFS route_type = 3" ;
    rdfs:comment "Транспортний засіб, що рухається автомобільною дорогою і використовується на автобусних маршрутах."@uk ;
    rdfs:subClassOf ns1:Vehicle .

ns1:BusRoute a owl:Class ;
    rdfs:label "Автобусний маршрут"@uk ;
    dcterms:source "GTFS routes.txt" ;
    rdfs:comment "Транспортний маршрут, що обслуговується автобусами і має GTFS route_type = 3."@uk ;
    rdfs:subClassOf ns1:TransportRoute .

ns1:Congestion a owl:Class ;
    rdfs:label "Затор"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Подія, що спричиняє зниження швидкості руху на ділянці мережі та збільшення затримки."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:Congestion_Horodotska a ns1:Congestion,
        ns1:Event,
        ns1:MobilitySystem,
        ns1:TransportSystem ;
    ns1:affectsSegment ns1:Seg_Vokzal_Rynok ;
    ns1:affectsTrip ns1:Trip_9_0800 ;
    ns1:eventTime "2026-10-27T08:10:00"^^xsd:dateTime ;
    ns1:handledBy ns1:Dispatcher_01 .

ns1:Delay a owl:Class ;
    rdfs:label "Затримка"@uk ;
    dcterms:source "ЛР4, ЛР6; SIRI" ;
    rdfs:comment "Вимірювання відхилення фактичного часу руху рейсу від планового часу розкладу."@uk ;
    rdfs:subClassOf ns1:Measurement .

ns1:DelayedState a owl:Class ;
    rdfs:label "Стан затримки"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Стан рейсу, за якого фактичний час виконання перевищує плановий час розкладу."@uk ;
    rdfs:subClassOf ns1:TransportState .

ns1:LoadFactor a owl:Class ;
    rdfs:label "Завантаженість"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Вимірювання частки використаної місткості транспортного засобу на рейсі."@uk ;
    rdfs:subClassOf ns1:Measurement .

ns1:PassengerFlow a owl:Class ;
    rdfs:label "Пасажиропотік"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Вимірювання кількості пасажирів, що проходять через зупинку або ділянку за одиницю часу."@uk ;
    rdfs:subClassOf ns1:Measurement .

ns1:Recommendation_R1 a ns1:Analytics,
        ns1:MobilitySystem,
        ns1:Recommendation,
        ns1:TransportSystem ;
    ns1:forPassenger ns1:Passenger_P01 ;
    ns1:recommendationOfDecision ns1:Decision_D1 ;
    ns1:recommends ns1:Route_31 .

ns1:ServiceCalendar a owl:Class ;
    rdfs:label "Календар обслуговування"@uk ;
    dcterms:source "GTFS calendar.txt, calendar_dates.txt" ;
    rdfs:comment "Розклад, що визначає множину дат, у які доступне обслуговування маршруту."@uk ;
    rdfs:subClassOf ns1:Schedule .

ns1:TravelTime a owl:Class ;
    rdfs:label "Час у дорозі"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Вимірювання тривалості проходження ділянки або виконання поїздки між зупинками."@uk ;
    rdfs:subClassOf ns1:Measurement .

ns1:hasEvent a owl:ObjectProperty ;
    rdfs:label "має подію"@uk ;
    rdfs:comment "Ділянка мережі має пов’язану подію, що змінює умови руху."@uk ;
    rdfs:domain ns1:NetworkSegment ;
    rdfs:range ns1:Event ;
    owl:inverseOf ns1:affectsSegment .

ns1:Dispatcher a owl:Class ;
    rdfs:label "Диспетчер"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Учасник процесу, що контролює виконання рейсів і реагує на події в реальному часі."@uk ;
    rdfs:subClassOf ns1:Actor .

ns1:Network_Lviv a ns1:MobilitySystem,
        ns1:TransportNetwork,
        ns1:TransportSystem ;
    ns1:describedByDataset ns1:GTFS_Lviv,
        ns1:NeTEx_Lviv,
        ns1:SIRI_Lviv ;
    ns1:partOf ns1:System_Lviv .

ns1:OnTimeState a owl:Class ;
    rdfs:label "Стан за розкладом"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Стан рейсу, за якого фактичний час виконання відповідає плановому часу розкладу."@uk ;
    rdfs:subClassOf ns1:TransportState .

ns1:Route_25 a ns1:BusRoute,
        ns1:MobilitySystem,
        ns1:TransportNetwork,
        ns1:TransportRoute,
        ns1:TransportSystem ;
    ns1:hasTrip ns1:Trip_25_0815 ;
    ns1:routeFrequency ns1:Frequency_R25 ;
    ns1:routeId "25" ;
    ns1:routeType 3 ;
    ns1:servesStop ns1:Stop_Universytet,
        ns1:Stop_Vokzal .

ns1:Route_31 a ns1:MobilitySystem,
        ns1:TramRoute,
        ns1:TransportNetwork,
        ns1:TransportRoute,
        ns1:TransportSystem ;
    ns1:hasTrip ns1:Trip_31_0700 ;
    ns1:recommendedBy ns1:Recommendation_R1 ;
    ns1:routeId "31" ;
    ns1:routeType 0 ;
    ns1:servesStop ns1:Stop_Rynok,
        ns1:Stop_Vokzal .

ns1:DecisionSupport a owl:Class ;
    rdfs:label "Підтримка рішень"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Аналітичний процес, що поєднує прогнози й правила для вибору управлінської дії."@uk ;
    rdfs:subClassOf ns1:Analytics .

ns1:Driver a owl:Class ;
    rdfs:label "Водій"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Учасник процесу, що керує транспортним засобом під час виконання рейсу."@uk ;
    rdfs:subClassOf ns1:Actor .

ns1:Frequency a owl:Class ;
    rdfs:label "Інтервал руху"@uk ;
    dcterms:source "GTFS frequencies.txt" ;
    rdfs:comment "Запис розкладу про проміжок часу між послідовними відправленнями рейсів на маршруті."@uk ;
    rdfs:subClassOf ns1:Schedule .

ns1:Passenger a owl:Class ;
    rdfs:label "Пасажир"@uk ;
    dcterms:source "ЛР4, ЛР6; schema:Person" ;
    rdfs:comment "Учасник процесу, що користується транспортом і здійснює поїздку між зупинками."@uk ;
    rdfs:seeAlso schema:Person ;
    rdfs:subClassOf ns1:Actor ;
    skos:closeMatch schema:Person .

ns1:TransportNode a owl:Class ;
    rdfs:label "Транспортний вузол"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Елемент транспортної мережі, що є зупинкою або пересадочним вузлом і з’єднує ділянки мережі."@uk ;
    rdfs:subClassOf ns1:TransportNetwork .

ns1:Forecast a owl:Class ;
    rdfs:label "Прогноз"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Аналітичний результат, що оцінює майбутній пасажиропотік, затримку або час у дорозі."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:forecastFor ;
            owl:someValuesFrom ns1:Trip ],
        ns1:Analytics .

ns1:Route_9 a ns1:BusRoute,
        ns1:MobilitySystem,
        ns1:TransportNetwork,
        ns1:TransportRoute,
        ns1:TransportSystem ;
    ns1:hasTrip ns1:Trip_9_0800,
        ns1:Trip_9_0830 ;
    ns1:routeFrequency ns1:Frequency_R9 ;
    ns1:routeId "9" ;
    ns1:routeType 3 ;
    ns1:servesStop ns1:Stop_Politekhnika,
        ns1:Stop_Rynok,
        ns1:Stop_Vokzal .

ns1:Stop_Rynok a ns1:InterchangeStop,
        ns1:MobilitySystem,
        ns1:Stop,
        ns1:TransportNetwork,
        ns1:TransportNode,
        ns1:TransportSystem ;
    ns1:isEndOf ns1:Trip_31_0700,
        ns1:Trip_9_0800,
        ns1:Trip_9_0830 ;
    ns1:latitude 49.8419 ;
    ns1:longitude 24.0315 ;
    ns1:servedByRoute ns1:Route_31,
        ns1:Route_9 ;
    ns1:stopAtTime ns1:StopTime_T9_Rynok ;
    ns1:stopId "S002" ;
    ns1:stopName "Площа Ринок" ;
    ns1:wheelchairAccessible false .

ns1:Trip_25_0815 a ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Trip ;
    ns1:endsAt ns1:Stop_Universytet ;
    ns1:hasState ns1:State_OnTime_25 ;
    ns1:operatedBy ns1:Agency_LvivAvtobus ;
    ns1:startsAt ns1:Stop_Vokzal ;
    ns1:tripId "T250815" ;
    ns1:tripOfRoute ns1:Route_25 ;
    ns1:usesVehicle ns1:Bus_2502 .

ns1:Trip_9_0830 a ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Trip ;
    ns1:endsAt ns1:Stop_Rynok ;
    ns1:hasState ns1:State_OnTime_9_0830 ;
    ns1:operatedBy ns1:Agency_LvivAvtobus ;
    ns1:startsAt ns1:Stop_Vokzal ;
    ns1:tripId "T090830" ;
    ns1:tripOfRoute ns1:Route_9 ;
    ns1:usesVehicle ns1:Bus_2502 .

ns1:Analytics a owl:Class ;
    rdfs:label "Аналітика"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Процес обробки даних, що перетворює вимірювання на прогнози, оцінки та рекомендації."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:NetworkSegment a owl:Class ;
    rdfs:label "Ділянка мережі"@uk ;
    dcterms:source "ЛР5, ЛР6; GTFS shapes.txt" ;
    rdfs:comment "Частина транспортної мережі між двома сусідніми зупинками, що має час і відстань проходження."@uk ;
    rdfs:seeAlso schema:Place ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Event ;
            owl:onProperty ns1:hasEvent ],
        ns1:TransportNetwork ;
    skos:closeMatch schema:Place .

ns1:Recommendation a owl:Class ;
    rdfs:label "Рекомендація"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Аналітичний результат, що пропонує пасажиру або диспетчеру конкретну дію щодо маршруту чи рейсу."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:recommends ;
            owl:someValuesFrom ns1:TransportRoute ],
        ns1:Analytics .

ns1:TransportAgency a owl:Class ;
    rdfs:label "Перевізник"@uk ;
    dcterms:source "GTFS agency.txt; schema:Organization" ;
    rdfs:comment "Організація, що надає транспортні послуги, володіє рухомим складом і публікує дані."@uk ;
    rdfs:seeAlso schema:Organization ;
    rdfs:subClassOf ns1:Actor ;
    skos:closeMatch schema:Organization .

ns1:Trip_31_0700 a ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Trip ;
    ns1:endsAt ns1:Stop_Rynok ;
    ns1:hasDriver ns1:Driver_02 ;
    ns1:hasState ns1:State_OnTime_31 ;
    ns1:hasStopTime ns1:StopTime_T31_Vokzal ;
    ns1:operatedBy ns1:Agency_LvivElektrotrans ;
    ns1:startsAt ns1:Stop_Vokzal ;
    ns1:tripId "T310700" ;
    ns1:tripOfRoute ns1:Route_31 ;
    ns1:usesVehicle ns1:Tram_0903 .

ns1:Sensor a owl:Class ;
    rdfs:label "Сенсор"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Пристрій, що автоматично вимірює стан транспортного процесу та передає дані в систему."@uk ;
    rdfs:subClassOf ns1:DataAsset .

ns1:Stop_Vokzal a ns1:AccessibleStop,
        ns1:InterchangeStop,
        ns1:MobilitySystem,
        ns1:Stop,
        ns1:TransportNetwork,
        ns1:TransportNode,
        ns1:TransportSystem ;
    ns1:isStartOf ns1:Trip_25_0815,
        ns1:Trip_31_0700,
        ns1:Trip_9_0800,
        ns1:Trip_9_0830 ;
    ns1:latitude 49.8397 ;
    ns1:longitude 24.0045 ;
    ns1:servedByRoute ns1:Route_25,
        ns1:Route_31,
        ns1:Route_9 ;
    ns1:stopAtTime ns1:StopTime_T31_Vokzal,
        ns1:StopTime_T9_Vokzal ;
    ns1:stopId "S001" ;
    ns1:stopName "Вокзал" ;
    ns1:wheelchairAccessible true .

ns1:TransportState a owl:Class ;
    rdfs:label "Стан рейсу"@uk ;
    dcterms:source "ЛР6; SIRI" ;
    rdfs:comment "Стан виконання рейсу, що характеризує його відповідність розкладу та завантаженість."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Schedule a owl:Class ;
    rdfs:label "Розклад"@uk ;
    dcterms:source "GTFS calendar.txt, frequencies.txt" ;
    rdfs:comment "План виконання рейсів, що визначає дати, часи та інтервали руху на маршрутах."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:StopTime a owl:Class ;
    rdfs:label "Зупиночний час"@uk ;
    dcterms:source "GTFS stop_times.txt" ;
    rdfs:comment "Запис розкладу про прибуття або відправлення рейсу на конкретній зупинці."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Stop ;
            owl:onProperty ns1:atStop ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:Schedule .

ns1:Actor a owl:Class ;
    rdfs:label "Учасник процесу"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Особа або організація, що бере участь у транспортному процесі та прийнятті рішень."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Measurement a owl:Class ;
    rdfs:label "Вимірювання"@uk ;
    dcterms:source "ЛР6" ;
    rdfs:comment "Кількісна характеристика транспортного процесу, отримана від сенсора або обчислена аналітикою."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Vehicle a owl:Class ;
    rdfs:label "Транспортний засіб"@uk ;
    dcterms:source "ЛР4, ЛР6; GTFS trips.txt" ;
    rdfs:comment "Рухомий склад, що виконує рейси на маршрутах і має ідентифікатор та пасажиромісткість."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:DataAsset a owl:Class ;
    rdfs:label "Джерело даних"@uk ;
    dcterms:source "ЛР4, ЛР6" ;
    rdfs:comment "Ресурс, що містить структуровані дані про мережу, рух або пасажирів і використовується аналітикою."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Event a owl:Class ;
    rdfs:label "Подія"@uk ;
    dcterms:source "ЛР4, ЛР6; schema:Event" ;
    rdfs:comment "Зміна умов транспортного процесу, що виникає в часі та впливає на мережу або рейс."@uk ;
    rdfs:seeAlso schema:Event ;
    rdfs:subClassOf ns1:TransportSystem ;
    skos:closeMatch schema:Event .

ns1:TransportNetwork a owl:Class ;
    rdfs:label "Транспортна мережа"@uk ;
    dcterms:source "ЛР4, ЛР6; GTFS Reference 2026" ;
    rdfs:comment "Транспортна система, що складається з вузлів, ділянок і маршрутів та утворює граф міста."@uk ;
    rdfs:subClassOf ns1:TransportSystem .

ns1:Trip_9_0800 a ns1:DelayedTrip,
        ns1:MobilitySystem,
        ns1:TransportSystem,
        ns1:Trip ;
    ns1:affectedByEvent ns1:Congestion_Horodotska ;
    ns1:endsAt ns1:Stop_Rynok ;
    ns1:forecastOfTrip ns1:Forecast_9_Peak ;
    ns1:hasDriver ns1:Driver_01 ;
    ns1:hasMeasurement ns1:Delay_9_0800,
        ns1:Load_9_0800,
        ns1:TravelTime_9_0800 ;
    ns1:hasState ns1:State_Delayed_9 ;
    ns1:hasStopTime ns1:StopTime_T9_Politekhnika,
        ns1:StopTime_T9_Rynok,
        ns1:StopTime_T9_Vokzal ;
    ns1:operatedBy ns1:Agency_LvivAvtobus ;
    ns1:startsAt ns1:Stop_Vokzal ;
    ns1:tripId "T090800" ;
    ns1:tripOfRoute ns1:Route_9 ;
    ns1:usesVehicle ns1:Bus_2501 .

ns1:TransportRoute a owl:Class ;
    rdfs:label "Транспортний маршрут"@uk ;
    dcterms:source "GTFS routes.txt; schema:Route" ;
    rdfs:comment "Упорядкована послідовність зупинок, що обслуговується рейсами під спільним ідентифікатором."@uk ;
    rdfs:seeAlso schema:Route ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:servesStop ;
            owl:someValuesFrom ns1:Stop ],
        ns1:TransportNetwork ;
    skos:closeMatch schema:Route .

ns1:Stop a owl:Class ;
    rdfs:label "Зупинка"@uk ;
    dcterms:source "GTFS stops.txt; schema:BusStop" ;
    rdfs:comment "Транспортний вузол, у якому пасажири здійснюють посадку або висадку, а транспортні засоби зупиняються за розкладом."@uk ;
    rdfs:seeAlso schema:BusStop ;
    rdfs:subClassOf ns1:TransportNode ;
    skos:closeMatch schema:BusStop .

ns1:Trip a owl:Class ;
    rdfs:label "Рейс"@uk ;
    dcterms:source "GTFS trips.txt, stop_times.txt" ;
    rdfs:comment "Конкретне виконання маршруту в певний час, що складається з послідовності зупинок і зупиночних часів."@uk ;
    rdfs:seeAlso schema:Trip ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Vehicle ;
            owl:onProperty ns1:usesVehicle ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasStopTime ;
            owl:someValuesFrom ns1:StopTime ],
        [ a owl:Restriction ;
            owl:onClass ns1:TransportAgency ;
            owl:onProperty ns1:operatedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:TransportSystem ;
    skos:closeMatch schema:Trip .

ns1:MobilitySystem a owl:Class ;
    rdfs:label "Інтелектуальна мобільність"@uk ;
    dcterms:source "ЛР4, ЛР6; Domain Knowledge Hub" ;
    rdfs:comment "Предметна область, що охоплює транспортну систему, дані, учасників і процеси прийняття рішень для управління міською мобільністю."@uk .

ns1:TransportSystem a owl:Class ;
    rdfs:label "Транспортна система"@uk ;
    dcterms:source "ЛР4, ЛР6; GTFS Reference 2026" ;
    rdfs:comment "Система, що об’єднує транспортну мережу, рухомий склад, рейси, учасників і управлінські процеси міста."@uk ;
    rdfs:subClassOf ns1:MobilitySystem .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Stop ns1:NetworkSegment ns1:TransportRoute ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:GTFSDataset ns1:SIRIFeed ns1:NeTExDataset ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:DelayedState ns1:OnTimeState ns1:CrowdedState ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:PassengerFlow ns1:LoadFactor ns1:Delay ns1:TravelTime ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:BusRoute ns1:TramRoute ns1:TrolleybusRoute ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Congestion ns1:Roadwork ns1:VehicleFailure ns1:PassengerSurge ns1:WeatherEvent ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Bus ns1:Tram ns1:Trolleybus ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Passenger ns1:Driver ns1:Dispatcher ns1:TransportAgency ) .

