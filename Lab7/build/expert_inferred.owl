  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportState">
    <rdfs:label xml:lang="uk">Стан рейсу</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:comment xml:lang="uk">Стан виконання рейсу, що характеризує його відповідність розкладу та завантаженість.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#latitude">
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="uk">широта</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="uk">Географічна широта зупинки в градусах.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#LoadFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Завантаженість</rdfs:label>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
    <rdfs:comment xml:lang="uk">Вимірювання частки використаної місткості транспортного засобу на рейсі.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Counter_2501">
    <ns1:sensorId>CNT-2501</ns1:sensorId>
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#PassengerCounter"/>
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#MobilitySystem"/>
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <rdf:type rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
    <ns1:measures rdf:resource="https://knowledge.uni.lviv.ua/mobility#Load_9_0800"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportNode">
    <rdfs:comment xml:lang="uk">Елемент транспортної мережі, що є зупинкою або пересадочним вузлом і з’єднує ділянки мережі.</rdfs:comment>
    <rdfs:label xml:lang="uk">Транспортний вузол</rdfs:label>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#DataAsset">
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
    <rdfs:comment xml:lang="uk">Ресурс, що містить структуровані дані про мережу, рух або пасажирів і використовується аналітикою.</rdfs:comment>
    <rdfs:label xml:lang="uk">Джерело даних</rdfs:label>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
