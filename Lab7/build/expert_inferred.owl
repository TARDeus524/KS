  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#InterchangeStop">
    <dcterms:source>ЛР4, ЛР6; GTFS transfers.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:label xml:lang="uk">Пересадочна зупинка</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://schema.org/BusStop"/>
    <rdfs:comment xml:lang="uk">Зупинка, яку обслуговують щонайменше два різні транспортні маршрути і на якій можлива пересадка.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://schema.org/BusStop"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n7a23484eb6ee4007a3d0385e20f80293b13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportAgency">
    <rdfs:label xml:lang="uk">Перевізник</rdfs:label>
