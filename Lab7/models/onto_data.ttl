mm:Route_9 a mm:BusRoute ;
    mm:hasTrip mm:Trip_9_0800,
        mm:Trip_9_0830 ;
    mm:routeFrequency mm:Frequency_R9 ;
    mm:routeId "9" ;
    mm:routeType 3 ;
    mm:servesStop mm:Stop_Politekhnika,
        mm:Stop_Rynok,
        mm:Stop_Vokzal .

