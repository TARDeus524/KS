@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mm:Calendar_2026 a mm:ServiceCalendar ;
    rdfs:label "Будні 2026"@uk ;
    mm:validFrom "2026-01-01" ;
    mm:validTo "2026-12-31" .

mm:Frequency_R25 a mm:Frequency ;
    mm:frequencyOfRoute mm:Route_25 ;
    mm:headwayMinutes 15 .

mm:GTFS_Lviv a mm:GTFSDataset ;
    mm:datasetDescribes mm:Network_Lviv ;
    mm:datasetName "GTFS Lviv 2026" .

mm:NeTEx_Lviv a mm:NeTExDataset ;
    mm:datasetDescribes mm:Network_Lviv ;
    mm:datasetName "NeTEx Lviv 2026" .

mm:Passenger_P02 a mm:Passenger ;
    mm:personName "Софія Бондар" .

mm:SIRI_Lviv a mm:SIRIFeed ;
    mm:datasetDescribes mm:Network_Lviv ;
    mm:datasetName "SIRI Lviv realtime" .

mm:StopTime_T31_Vokzal a mm:StopTime ;
    mm:atStop mm:Stop_Vokzal ;
    mm:departureTime "07:00:00" ;
    mm:stopSequence 1 ;
    mm:stopTimeOfTrip mm:Trip_31_0700 .

mm:Trolleybus_1101 a mm:Trolleybus ;
    mm:capacity 110 ;
    mm:vehicleId "TB1101" .

<https://knowledge.uni.lviv.ua/mobility/data> a owl:Ontology ;
    owl:imports <https://knowledge.uni.lviv.ua/mobility> ;
    owl:versionInfo "1.0" .

mm:Agency_LvivElektrotrans a mm:TransportAgency ;
    mm:agencyName "ЛьвівЕлектротранс" ;
    mm:operatesTrip mm:Trip_31_0700 .

mm:Bus_2501 a mm:Bus ;
    mm:assignedToTrip mm:Trip_9_0800 ;
    mm:capacity 90 ;
    mm:vehicleId "B2501" .

mm:Counter_2501 a mm:PassengerCounter ;
    mm:measures mm:Load_9_0800 ;
    mm:sensorId "CNT-2501" .

mm:Decision_D1 a mm:DecisionSupport ;
    mm:basedOnForecast mm:Forecast_9_Peak ;
    mm:hasRecommendation mm:Recommendation_R1 .

mm:Dispatcher_01 a mm:Dispatcher ;
    mm:personName "Марія Шевчук" ;
    mm:respondsTo mm:Congestion_Horodotska .

mm:Driver_01 a mm:Driver ;
    mm:drivesTrip mm:Trip_9_0800 ;
    mm:personName "Іван Петренко" .

mm:Driver_02 a mm:Driver ;
    mm:drivesTrip mm:Trip_31_0700 ;
    mm:personName "Олена Коваль" .

mm:Flow_Vokzal_0800 a mm:PassengerFlow ;
    mm:measuredBy mm:Validator_Vokzal ;
    mm:passengerCount 120 .

mm:Forecast_9_Peak a mm:Forecast ;
    mm:confidence 0.87 ;
    mm:forecastFor mm:Trip_9_0800 .

mm:Frequency_R9 a mm:Frequency ;
    mm:frequencyOfRoute mm:Route_9 ;
    mm:headwayMinutes 10 .

mm:GPS_2501 a mm:GPSTracker ;
    mm:measures mm:Delay_9_0800,
        mm:TravelTime_9_0800 ;
    mm:sensorId "GPS-2501" .

mm:Passenger_P01 a mm:Passenger ;
    mm:passengerRecommendation mm:Recommendation_R1 ;
    mm:personName "Андрій Мельник" .

mm:Roadwork_Stryiska a mm:Roadwork ;
    mm:affectsSegment mm:Seg_Rynok_Politekhnika ;
    mm:eventTime "2026-10-27T07:00:00"^^xsd:dateTime .

mm:Seg_Rynok_Politekhnika a mm:NetworkSegment ;
    rdfs:label "Площа Ринок — Політехніка"@uk ;
