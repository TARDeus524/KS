    mm:capacity 180 ;
    mm:vehicleId "T0903" .

mm:Validator_Vokzal a mm:TicketValidator ;
    mm:measures mm:Flow_Vokzal_0800 ;
    mm:sensorId "VAL-S001" .

mm:Bus_2502 a mm:Bus ;
    mm:assignedToTrip mm:Trip_25_0815,
        mm:Trip_9_0830 ;
    mm:capacity 85 ;
    mm:vehicleId "B2502" .

mm:Delay_9_0800 a mm:Delay ;
    mm:delayMinutes 12 ;
    mm:measuredBy mm:GPS_2501 ;
    mm:measurementOf mm:Trip_9_0800 .

mm:Load_9_0800 a mm:LoadFactor ;
    mm:loadFactor 0.92 ;
    mm:measuredBy mm:Counter_2501 ;
    mm:measurementOf mm:Trip_9_0800 .

mm:Recommendation_R1 a mm:Recommendation ;
