mm:State_Delayed_9 a mm:DelayedState ;
    mm:stateOfTrip mm:Trip_9_0800 .

mm:State_OnTime_25 a mm:OnTimeState ;
    mm:stateOfTrip mm:Trip_25_0815 .

mm:State_OnTime_31 a mm:OnTimeState ;
    mm:stateOfTrip mm:Trip_31_0700 .

mm:State_OnTime_9_0830 a mm:OnTimeState ;
