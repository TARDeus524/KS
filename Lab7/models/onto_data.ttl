    mm:handledBy mm:Dispatcher_01 .

mm:Network_Lviv a mm:TransportNetwork ;
    mm:partOf mm:System_Lviv .

mm:Route_25 a mm:BusRoute ;
    mm:hasTrip mm:Trip_25_0815 ;
    mm:routeId "25" ;
    mm:routeType 3 ;
    mm:servesStop mm:Stop_Universytet,
        mm:Stop_Vokzal .

mm:Route_31 a mm:TramRoute ;
    mm:hasTrip mm:Trip_31_0700 ;
    mm:routeId "31" ;
    mm:routeType 0 ;
    mm:servesStop mm:Stop_Rynok,
        mm:Stop_Vokzal .

mm:Trip_25_0815 a mm:Trip ;
    mm:endsAt mm:Stop_Universytet ;
