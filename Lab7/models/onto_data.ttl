    mm:longitude 24.022 ;
    mm:servedByRoute mm:Route_25 ;
    mm:stopId "S004" ;
    mm:stopName "Університет" ;
    mm:wheelchairAccessible false .

mm:TravelTime_9_0800 a mm:TravelTime ;
