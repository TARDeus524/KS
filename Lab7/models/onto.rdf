  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#frequencyOfRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є інтервалом маршруту</rdfs:label>
    <rdfs:comment xml:lang="uk">Запис інтервалу руху належить конкретному маршруту.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Frequency"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#routeFrequency"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#WeatherEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Погіршення погоди</rdfs:label>
    <rdfs:comment xml:lang="uk">Подія, за якої погодні умови знижують швидкість або надійність руху транспорту.</rdfs:comment>
    <dcterms:source>SIRI; ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#servesStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">обслуговує зупинку</rdfs:label>
    <rdfs:comment xml:lang="uk">Маршрут обслуговує зупинку, на якій зупиняються його рейси.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#servedByRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#atStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">на зупинці</rdfs:label>
    <rdfs:comment xml:lang="uk">Запис часу зупинки стосується конкретної зупинки.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#StopTime"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#stopAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Tram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Трамвай</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейковий транспортний засіб, що рухається трамвайною колією у міській мережі.</rdfs:comment>
    <dcterms:source>GTFS route_type = 0</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#recommendationOfDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є рекомендацією рішення</rdfs:label>
    <rdfs:comment xml:lang="uk">Рекомендація походить від управлінського рішення.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Recommendation"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#DecisionSupport"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasRecommendation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5764a01007ad43c8986c56255a326ce3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
