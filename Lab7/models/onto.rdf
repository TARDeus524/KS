  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#PassengerFlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Пасажиропотік</rdfs:label>
    <rdfs:comment xml:lang="uk">Вимірювання кількості пасажирів, що проходять через зупинку або ділянку за одиницю часу.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TrolleybusRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Тролейбусний маршрут</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортний маршрут, що обслуговується тролейбусами і має GTFS route_type = 11.</rdfs:comment>
    <dcterms:source>GTFS routes.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#handledBy">
