<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Congestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Затор</rdfs:label>
    <rdfs:comment xml:lang="uk">Подія, що спричиняє зниження швидкості руху на ділянці мережі та збільшення затримки.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Delay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Затримка</rdfs:label>
    <rdfs:comment xml:lang="uk">Вимірювання відхилення фактичного часу руху рейсу від планового часу розкладу.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#eventTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">час події</rdfs:label>
    <rdfs:comment xml:lang="uk">Дата й час виникнення події на мережі.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8dc419f2db6b4be295ad236b916f0f4b">
    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#OnTimeState"/>
    <rdf:rest rdf:nodeID="N13da341777664b3e87714e63f54bfe88"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#tripOfRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є рейсом маршруту</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс належить транспортному маршруту.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#routeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">тип маршруту</rdfs:label>
    <rdfs:comment xml:lang="uk">Код виду транспорту GTFS: 3 — автобус, 0 — трамвай, 11 — тролейбус.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N991400a2c2c4496a968cd402e2d378c6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://knowledge.uni.lviv.ua/mobility#operatedBy"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportAgency"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Vehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Транспортний засіб</rdfs:label>
    <rdfs:comment xml:lang="uk">Рухомий склад, що виконує рейси на маршрутах і має ідентифікатор та пасажиромісткість.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; GTFS trips.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#RouteShape">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Форма маршруту</rdfs:label>
    <rdfs:comment xml:lang="uk">Геометрія шляху руху транспортного засобу, подана послідовністю координат.</rdfs:comment>
    <dcterms:source>GTFS shapes.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Розклад</rdfs:label>
    <rdfs:comment xml:lang="uk">План виконання рейсів, що визначає дати, часи та інтервали руху на маршрутах.</rdfs:comment>
    <dcterms:source>GTFS calendar.txt, frequencies.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#forecastFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">прогнозує рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Прогноз стосується конкретного рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#forecastOfTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#stopTimeOfTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є часом рейсу</rdfs:label>
    <rdfs:comment xml:lang="uk">Запис часу зупинки належить конкретному рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#StopTime"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasStopTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N01cdbc9c2a5244aebe65115fd9afb408">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://knowledge.uni.lviv.ua/mobility#usesVehicle"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#operatesTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">виконує рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Перевізник виконує конкретний рейс.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportAgency"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#operatedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N36c9a214c64845c793b58ba5609d6a6a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N99057aea102c435c9f6ba583bcf08a9a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#CrowdedState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Стан перевантаження</rdfs:label>
    <rdfs:comment xml:lang="uk">Стан рейсу, за якого завантаженість перевищує допустимий рівень комфорту.</rdfs:comment>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#stateOfTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є станом рейсу</rdfs:label>
    <rdfs:comment xml:lang="uk">Стан описує конкретний рейс.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Actor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Учасник процесу</rdfs:label>
    <rdfs:comment xml:lang="uk">Особа або організація, що бере участь у транспортному процесі та прийнятті рішень.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Recommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Рекомендація</rdfs:label>
    <rdfs:comment xml:lang="uk">Аналітичний результат, що пропонує пасажиру або диспетчеру конкретну дію щодо маршруту чи рейсу.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Analytics"/>
    <rdfs:subClassOf rdf:nodeID="Na7a90ec7ee0b454e8c2c12505b07c8f9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N26dd6dafd03c4e8f8d747b41a4e83e33">
    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#NetworkSegment"/>
    <rdf:rest rdf:nodeID="N2284284feff743df8323339167f03b6b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#headwayMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">інтервал, хв</rdfs:label>
    <rdfs:comment xml:lang="uk">Проміжок між послідовними відправленнями рейсів у хвилинах.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Frequency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#PassengerCounter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Лічильник пасажирів</rdfs:label>
    <rdfs:comment xml:lang="uk">Сенсор, що вимірює кількість пасажирів у транспортному засобі або на зупинці.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#tripId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">ідентифікатор рейсу</rdfs:label>
    <rdfs:comment xml:lang="uk">Унікальний ідентифікатор рейсу з GTFS trips.txt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#measurementOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є вимірюванням</rdfs:label>
    <rdfs:comment xml:lang="uk">Вимірювання стосується конкретного рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasMeasurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TramRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Трамвайний маршрут</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортний маршрут, що обслуговується трамваями і має GTFS route_type = 0.</rdfs:comment>
    <dcterms:source>GTFS routes.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#wheelchairAccessible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">доступність</rdfs:label>
    <rdfs:comment xml:lang="uk">Ознака доступності зупинки для маломобільних пасажирів.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasStopTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має зупиночний час</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс містить записи часу прибуття та відправлення на зупинках.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#StopTime"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#stopTimeOfTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TicketValidator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Валідатор квитків</rdfs:label>
    <rdfs:comment xml:lang="uk">Сенсор, що фіксує факти валідації квитків і посадки пасажирів на зупинці.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#servedByRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">обслуговується маршрутом</rdfs:label>
    <rdfs:comment xml:lang="uk">Зупинка обслуговується транспортним маршрутом.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#servesStop"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#delayMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">затримка, хв</rdfs:label>
    <rdfs:comment xml:lang="uk">Відхилення фактичного часу відправлення від планового в хвилинах.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Delay"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Roadwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Ремонт дороги</rdfs:label>
    <rdfs:comment xml:lang="uk">Подія, що тимчасово обмежує пропускну здатність ділянки мережі через ремонтні роботи.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#supportsDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">підтримує рішення</rdfs:label>
    <rdfs:comment xml:lang="uk">Прогноз є підставою для управлінського рішення.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#DecisionSupport"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#basedOnForecast"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#stopName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">назва зупинки</rdfs:label>
    <rdfs:comment xml:lang="uk">Людиночитана назва зупинки.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportNetwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Транспортна мережа</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортна система, що складається з вузлів, ділянок і маршрутів та утворює граф міста.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; GTFS Reference 2026</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#agencyName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">назва перевізника</rdfs:label>
    <rdfs:comment xml:lang="uk">Офіційна назва транспортного перевізника.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportAgency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#forecastOfTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має прогноз</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс має прогнозне значення.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#forecastFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportAgency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Перевізник</rdfs:label>
    <rdfs:comment xml:lang="uk">Організація, що надає транспортні послуги, володіє рухомим складом і публікує дані.</rdfs:comment>
    <dcterms:source>GTFS agency.txt; schema:Organization</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
    <skos:closeMatch rdf:resource="https://schema.org/Organization"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5f14a396fabb4c93b68f345575230105">
    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#Congestion"/>
    <rdf:rest rdf:nodeID="Nf15efeb3959f40f88b44ec3ebc50f6c6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#passengerCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">кількість пасажирів</rdfs:label>
    <rdfs:comment xml:lang="uk">Кількість валідованих пасажирів за інтервал спостереження.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#PassengerFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#LoadFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Завантаженість</rdfs:label>
    <rdfs:comment xml:lang="uk">Вимірювання частки використаної місткості транспортного засобу на рейсі.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#datasetName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">назва набору даних</rdfs:label>
    <rdfs:comment xml:lang="uk">Людиночитана назва джерела даних.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#personName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">ім’я учасника</rdfs:label>
    <rdfs:comment xml:lang="uk">Людиночитане ім’я пасажира, водія або диспетчера.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9ac738c4f99640afbe4815b5b2f0d081">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N578dcb1d9a7f4af1b81fc22c5f0b6d00"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#InterchangeStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Пересадочна зупинка</rdfs:label>
    <rdfs:comment xml:lang="uk">Зупинка, яку обслуговують щонайменше два різні транспортні маршрути і на якій можлива пересадка.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; GTFS transfers.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <skos:closeMatch rdf:resource="https://schema.org/BusStop"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/BusStop"/>
    <owl:equivalentClass rdf:nodeID="N36c9a214c64845c793b58ba5609d6a6a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#assignedToTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">призначений на рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортний засіб призначено на виконання рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#usesVehicle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#StopTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Зупиночний час</rdfs:label>
    <rdfs:comment xml:lang="uk">Запис розкладу про прибуття або відправлення рейсу на конкретній зупинці.</rdfs:comment>
    <dcterms:source>GTFS stop_times.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Schedule"/>
    <rdfs:subClassOf rdf:nodeID="N670233bfff9f4a149424741ac392b873"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#drivesTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">керує рейсом</rdfs:label>
    <rdfs:comment xml:lang="uk">Водій виконує конкретний рейс.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Driver"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#hasDriver"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Подія</rdfs:label>
    <rdfs:comment xml:lang="uk">Зміна умов транспортного процесу, що виникає в часі та впливає на мережу або рейс.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; schema:Event</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
    <skos:closeMatch rdf:resource="https://schema.org/Event"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#basedOnForecast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">ґрунтується на прогнозі</rdfs:label>
    <rdfs:comment xml:lang="uk">Рішення використовує конкретний прогноз.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#DecisionSupport"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#supportsDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#respondsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">реагує на подію</rdfs:label>
    <rdfs:comment xml:lang="uk">Диспетчер реагує на подію в реальному часі.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Dispatcher"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#handledBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#DelayedTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Затриманий рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс, фактичний стан якого відхилено від розкладу щонайменше на порогову величину затримки.</rdfs:comment>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:equivalentClass rdf:nodeID="Nf1b069fc2def4c8eac8c7bbf8e499a8e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має стан</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс перебуває в конкретному стані виконання.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#stateOfTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#stopAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має запис часу</rdfs:label>
    <rdfs:comment xml:lang="uk">Зупинка має записи часу прибуття та відправлення.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#StopTime"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#atStop"/>
  </rdf:Description>
