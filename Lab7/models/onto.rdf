    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#longitude">
