  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#OnTimeState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Стан за розкладом</rdfs:label>
    <rdfs:comment xml:lang="uk">Стан рейсу, за якого фактичний час виконання відповідає плановому часу розкладу.</rdfs:comment>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#datasetDescribes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">описує мережу</rdfs:label>
    <rdfs:comment xml:lang="uk">Джерело даних описує транспортну мережу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#describedByDataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#SIRIFeed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Потік SIRI</rdfs:label>
    <rdfs:comment xml:lang="uk">Джерело даних, що містить повідомлення SIRI про рух транспорту в реальному часі.</rdfs:comment>
    <dcterms:source>SIRI; Transmodel</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#confidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">впевненість прогнозу</rdfs:label>
    <rdfs:comment xml:lang="uk">Оцінка достовірності прогнозу від 0 до 1.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Analytics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Аналітика</rdfs:label>
    <rdfs:comment xml:lang="uk">Процес обробки даних, що перетворює вимірювання на прогнози, оцінки та рекомендації.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#VehicleFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Поломка транспортного засобу</rdfs:label>
    <rdfs:comment xml:lang="uk">Подія, за якої транспортний засіб не може продовжити виконання рейсу без заміни.</rdfs:comment>
    <dcterms:source>SIRI; ЛР6</dcterms:source>
