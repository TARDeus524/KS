    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">довгота</rdfs:label>
    <rdfs:comment xml:lang="uk">Географічна довгота зупинки в градусах.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Trolleybus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Тролейбус</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортний засіб з електроживленням від контактної мережі, що використовується на тролейбусних маршрутах.</rdfs:comment>
    <dcterms:source>GTFS route_type = 11</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Vehicle"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0001b63054ea4ae8b016f63fb5498947">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N7258d953fd5a4abfaaf4a741fd0620e0"/>
  </rdf:Description>
