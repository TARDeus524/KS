  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#routeFrequency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має інтервал</rdfs:label>
    <rdfs:comment xml:lang="uk">Маршрут має заданий інтервал руху.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Frequency"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#frequencyOfRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Стан рейсу</rdfs:label>
    <rdfs:comment xml:lang="uk">Стан виконання рейсу, що характеризує його відповідність розкладу та завантаженість.</rdfs:comment>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#recommends">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">рекомендує маршрут</rdfs:label>
    <rdfs:comment xml:lang="uk">Рекомендація пропонує конкретний маршрут.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Recommendation"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#recommendedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#BusRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Автобусний маршрут</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортний маршрут, що обслуговується автобусами і має GTFS route_type = 3.</rdfs:comment>
    <dcterms:source>GTFS routes.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Forecast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Прогноз</rdfs:label>
    <rdfs:comment xml:lang="uk">Аналітичний результат, що оцінює майбутній пасажиропотік, затримку або час у дорозі.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Analytics"/>
    <rdfs:subClassOf rdf:nodeID="N5764a01007ad43c8986c56255a326ce3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#interchangesWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="uk">має пересадку з</rdfs:label>
    <rdfs:comment xml:lang="uk">Симетричне відношення між зупинками, між якими можлива пересадка.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#DataAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Джерело даних</rdfs:label>
    <rdfs:comment xml:lang="uk">Ресурс, що містить структуровані дані про мережу, рух або пасажирів і використовується аналітикою.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#latitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">широта</rdfs:label>
    <rdfs:comment xml:lang="uk">Географічна широта зупинки в градусах.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#affectedByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">зазнає впливу події</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс зазнає впливу події на мережі.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Event"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#affectsTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#DelayedState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Стан затримки</rdfs:label>
    <rdfs:comment xml:lang="uk">Стан рейсу, за якого фактичний час виконання перевищує плановий час розкладу.</rdfs:comment>
    <dcterms:source>ЛР6; SIRI</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#sensorId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">ідентифікатор сенсора</rdfs:label>
    <rdfs:comment xml:lang="uk">Унікальний ідентифікатор пристрою вимірювання.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N29426201aae748fabb6f82347c9eafd7">
