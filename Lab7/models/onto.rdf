  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має вимірювання</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс має кількісні вимірювання затримки, завантаженості або часу.</rdfs:comment>
