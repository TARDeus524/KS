  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Driver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Водій</rdfs:label>
    <rdfs:comment xml:lang="uk">Учасник процесу, що керує транспортним засобом під час виконання рейсу.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
