    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdf:rest rdf:nodeID="N04fe0fc9926a41bdbf50ed77b6d9f0d3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#TransportSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Транспортна система</rdfs:label>
    <rdfs:comment xml:lang="uk">Система, що об’єднує транспортну мережу, рухомий склад, рейси, учасників і управлінські процеси міста.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; GTFS Reference 2026</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#MobilitySystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#operatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">виконується перевізником</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс виконується транспортним перевізником.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportAgency"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#operatesTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#GPSTracker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">GPS-трекер</rdfs:label>
    <rdfs:comment xml:lang="uk">Сенсор, що визначає координати, швидкість і час руху транспортного засобу.</rdfs:comment>
    <dcterms:source>ЛР6; GTFS realtime</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#NetworkSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Ділянка мережі</rdfs:label>
    <rdfs:comment xml:lang="uk">Частина транспортної мережі між двома сусідніми зупинками, що має час і відстань проходження.</rdfs:comment>
    <dcterms:source>ЛР5, ЛР6; GTFS shapes.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <rdfs:subClassOf rdf:nodeID="N3d5c921f8eb642db975117a42967a106"/>
    <skos:closeMatch rdf:resource="https://schema.org/Place"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Place"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Dispatcher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Диспетчер</rdfs:label>
    <rdfs:comment xml:lang="uk">Учасник процесу, що контролює виконання рейсів і реагує на події в реальному часі.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#loadFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="uk">коефіцієнт завантаженості</rdfs:label>
    <rdfs:comment xml:lang="uk">Відношення кількості пасажирів до місткості транспортного засобу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#LoadFactor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N496be8eb0ecb4f97be644dd328961c3f">
    <rdf:first rdf:resource="https://knowledge.uni.lviv.ua/mobility#GTFSDataset"/>
    <rdf:rest rdf:nodeID="Ne0ecf48b103c48e0acfd960039f15eb8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#measuredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">виміряне сенсором</rdfs:label>
    <rdfs:comment xml:lang="uk">Вимірювання отримане конкретним сенсором.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Measurement"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Sensor"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#measures"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#describedByDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">описана джерелом</rdfs:label>
    <rdfs:comment xml:lang="uk">Транспортна мережа описана конкретним джерелом даних.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportNetwork"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#datasetDescribes"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Trip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Рейс</rdfs:label>
    <rdfs:comment xml:lang="uk">Конкретне виконання маршруту в певний час, що складається з послідовності зупинок і зупиночних часів.</rdfs:comment>
    <dcterms:source>GTFS trips.txt, stop_times.txt</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
    <rdfs:subClassOf rdf:nodeID="N846922fbde81407e9ab0d63a6657271e"/>
    <rdfs:subClassOf rdf:nodeID="N01cdbc9c2a5244aebe65115fd9afb408"/>
    <rdfs:subClassOf rdf:nodeID="N991400a2c2c4496a968cd402e2d378c6"/>
    <skos:closeMatch rdf:resource="https://schema.org/Trip"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Trip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Measurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Вимірювання</rdfs:label>
    <rdfs:comment xml:lang="uk">Кількісна характеристика транспортного процесу, отримана від сенсора або обчислена аналітикою.</rdfs:comment>
    <dcterms:source>ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#TransportSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#forPassenger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">призначена пасажиру</rdfs:label>
    <rdfs:comment xml:lang="uk">Рекомендація адресована конкретному пасажиру.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Recommendation"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Passenger"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#passengerRecommendation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Passenger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Пасажир</rdfs:label>
    <rdfs:comment xml:lang="uk">Учасник процесу, що користується транспортом і здійснює поїздку між зупинками.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6; schema:Person</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Actor"/>
    <skos:closeMatch rdf:resource="https://schema.org/Person"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#hasDriver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">має водія</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс обслуговує конкретний водій.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Driver"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#drivesTrip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#isEndOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">є завершенням</rdfs:label>
    <rdfs:comment xml:lang="uk">Зупинка є кінцевою для рейсу.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#endsAt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Сенсор</rdfs:label>
    <rdfs:comment xml:lang="uk">Пристрій, що автоматично вимірює стан транспортного процесу та передає дані в систему.</rdfs:comment>
    <dcterms:source>ЛР4, ЛР6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#DataAsset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#AccessibleStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="uk">Доступна зупинка</rdfs:label>
    <rdfs:comment xml:lang="uk">Зупинка, обладнана для посадки та висадки маломобільних пасажирів, зокрема з ознакою доступності.</rdfs:comment>
    <dcterms:source>GTFS stops.txt; schema:BusStop</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:equivalentClass rdf:nodeID="Nc2721bbaf8e243568994619f4132df72"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://knowledge.uni.lviv.ua/mobility#endsAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">завершується на</rdfs:label>
    <rdfs:comment xml:lang="uk">Рейс завершується на заданій зупинці.</rdfs:comment>
    <rdfs:domain rdf:resource="https://knowledge.uni.lviv.ua/mobility#Trip"/>
    <rdfs:range rdf:resource="https://knowledge.uni.lviv.ua/mobility#Stop"/>
    <owl:inverseOf rdf:resource="https://knowledge.uni.lviv.ua/mobility#isEndOf"/>
  </rdf:Description>
