PREFIX mm: <https://knowledge.uni.lviv.ua/mobility#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?decision ?rec ?route WHERE { ?decision mm:basedOnForecast ?f ; mm:hasRecommendation ?rec . ?rec mm:recommends ?route . } ORDER BY ?decision
