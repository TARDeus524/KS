PREFIX mm: <https://knowledge.uni.lviv.ua/mobility#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?segment ?trip WHERE { ?segment mm:hasEvent mm:Congestion_Horodotska . mm:Congestion_Horodotska mm:affectsTrip ?trip . } ORDER BY ?segment ?trip
