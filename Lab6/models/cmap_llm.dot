digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.22, ranksep=0.75, fontname="DejaVu Sans", fontsize=20, bgcolor="white", pad=0.25, label="Карта LLM: прийняті триплети з цитатами (40 із 50)", labelloc=t];
  node [fontname="DejaVu Sans", margin="0.10,0.04", penwidth=1.0];
  edge [fontname="DejaVu Sans", fontsize=9, color="#566573", arrowsize=0.65, penwidth=1.0];
  "transport_system" [label="Транспортна система", shape=box,style="rounded,filled",fillcolor="#AED6F1",fontcolor="#1B2631",fontsize=10, tooltip="Сукупність транспортної мережі, рухомого складу, пасажирів, процесів руху й управління."];
  "network" [label="Транспортна мережа", shape=box,style="rounded,filled",fillcolor="#D6EAF8",fontcolor="#1B2631",fontsize=10, tooltip="Граф міста: зупинки, ділянки, пересадкові вузли та маршрути."];
  "stop" [label="Зупинка", shape=box,style="rounded,filled",fillcolor="#D6EAF8",fontcolor="#1B2631",fontsize=10, tooltip="Місце посадки/висадки пасажирів; вузол транспортного графа."];
  "route" [label="Маршрут", shape=box,style="rounded,filled",fillcolor="#D6EAF8",fontcolor="#1B2631",fontsize=10, tooltip="Упорядкована послідовність зупинок, яку обслуговують рейси під спільним ідентифікатором."];
  "traffic" [label="Рух транспорту", shape=box,style="rounded,filled",fillcolor="#FADBD8",fontcolor="#1B2631",fontsize=10, tooltip="Процес переміщення транспортних засобів мережею та його характеристики."];
  "vehicle" [label="Транспортний засіб", shape=box,style="rounded,filled",fillcolor="#D5F5E3",fontcolor="#1B2631",fontsize=10, tooltip="Рухомий склад, що виконує рейси на маршрутах."];
  "gps" [label="GPS-трекер", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="GPS-пристрій транспортного засобу, що дає координати й швидкість у часі."];
  "gtfs" [label="GTFS-дані", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Стандартний набір CSV-файлів для опису маршрутів, рейсів, зупинок і розкладів."];
  "netex" [label="NeTEx", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="XML-схема CEN, що реалізує центральні компоненти Transmodel."];
  "siri" [label="SIRI", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Специфікація CEN для обміну даними громадського транспорту в реальному часі."];
  "transmodel" [label="Transmodel (EN 12896)", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Європейський еталонний модель даних для інформації громадського транспорту."];
  "public_transport_info" [label="Інформація для\nпасажирів", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Інформація про маршрути, час прибуття та пересадки для пасажирів."];
  "agency" [label="Агентство-перевізник", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Перевізник, що надає транспортні послуги та публікує дані."];
  "block" [label="Блок рейсів", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Послідовні рейси одного транспортного засобу протягом service day."];
  "data_source" [label="Джерело транспортних\nданих", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Узагальнене джерело даних про мережу, рух або пасажирів."];
  "frequency" [label="Запис frequencies", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Запис frequencies.txt про headway для рейсу на заданому інтервалі часу."];
  "stop_time" [label="Запис stop_times", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Запис у stop_times.txt: час прибуття/відправлення рейсу на зупинці."];
  "transfer" [label="Пересадка (GTFS)", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Правило з'єднання між рейсами або маршрутами у точці пересадки."];
  "data_standard" [label="Стандарт даних", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Формалізована специфікація структури й обміну транспортними даними."];
  "fare" [label="Тариф", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Вартість і правила оплати проїзду для маршрутів."];
  "shape" [label="Форма маршруту", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Геометрія шляху руху транспортного засобу (shapes.txt)."];
  "pathway" [label="Шлях у станції", shape=box,style="rounded,filled",fillcolor="#E5E8E8",fontcolor="#1B2631",fontsize=10, tooltip="Пішохідний зв'язок між елементами станції (pathways.txt)."];
  "headway" [label="Інтервал руху", shape=box,style="rounded,filled",fillcolor="#E8DAEF",fontcolor="#1B2631",fontsize=10, tooltip="Інтервал між послідовними відправленнями рейсів на зупинці."];
  "service" [label="Календар\nобслуговування", shape=box,style="rounded,filled",fillcolor="#E8DAEF",fontcolor="#1B2631",fontsize=10, tooltip="Набір дат, коли рейс доступний (calendar.txt / calendar_dates.txt)."];
  "trip" [label="Рейс", shape=box,style="rounded,filled",fillcolor="#E8DAEF",fontcolor="#1B2631",fontsize=10, tooltip="Конкретне виконання маршруту в певний час; послідовність щонайменше двох зупинок."];
  "schedule" [label="Розклад", shape=box,style="rounded,filled",fillcolor="#E8DAEF",fontcolor="#1B2631",fontsize=10, tooltip="План відправлень рейсів та інтервалів руху на добу або інший період."];
  "journey" [label="Поїздка", shape=box,style="rounded,filled",fillcolor="#FCF3CF",fontcolor="#1B2631",fontsize=10, tooltip="Переміщення пасажира від початкової до кінцевої точки, включно з пересадками."];
  "travel_time" [label="Час у дорозі", shape=box,style="rounded,filled",fillcolor="#FADBD8",fontcolor="#1B2631",fontsize=10, tooltip="Тривалість поїздки або проходження ділянки/маршруту."];
  "its" [label="Інтелектуальна\nтранспортна система", shape=box,style="rounded,filled",fillcolor="#AED6F1",fontcolor="#1B2631",fontsize=10, tooltip="Система, що застосовує ІКТ для управління транспортом і мобільністю."];
  "bus" [label="Автобус", shape=box,style="rounded,filled",fillcolor="#D5F5E3",fontcolor="#1B2631",fontsize=10, tooltip="Вид міського транспорту; автобусний маршрут у GTFS має route_type=3."];
  "metro" [label="Метро", shape=box,style="rounded,filled",fillcolor="#D5F5E3",fontcolor="#1B2631",fontsize=10, tooltip="Підземний рейковий транспорт; у GTFS route_type=1."];
  "tram" [label="Трамвай", shape=box,style="rounded,filled",fillcolor="#D5F5E3",fontcolor="#1B2631",fontsize=10, tooltip="Вид рейкового міського транспорту; у GTFS route_type=0."];
  "trolleybus" [label="Тролейбус", shape=box,style="rounded,filled",fillcolor="#D5F5E3",fontcolor="#1B2631",fontsize=10, tooltip="Електричний автобус із живленням від контактної мережі; у GTFS route_type=11."];
  "gtfs" -> "data_source" [label="є різновидом", style="bold"];
  "gtfs" -> "route" [label="містить", ];
  "gtfs" -> "stop" [label="містить", ];
  "gtfs" -> "trip" [label="містить", ];
  "gtfs" -> "schedule" [label="містить", ];
  "route" -> "trip" [label="містить", ];
  "trip" -> "service" [label="регламентується", ];
  "trip" -> "stop" [label="містить", ];
  "route" -> "stop" [label="обслуговує", ];
  "trip" -> "stop_time" [label="містить", ];
  "stop_time" -> "stop" [label="розташована на", ];
  "frequency" -> "headway" [label="містить", ];
  "frequency" -> "trip" [label="залежить від", ];
  "transfer" -> "route" [label="залежить від", ];
  "shape" -> "trip" [label="залежить від", ];
  "agency" -> "route" [label="містить", ];
  "fare" -> "route" [label="містить", ];
  "block" -> "trip" [label="містить", ];
  "bus" -> "vehicle" [label="є різновидом", style="bold"];
  "tram" -> "vehicle" [label="є різновидом", style="bold"];
  "metro" -> "vehicle" [label="є різновидом", style="bold"];
  "trolleybus" -> "vehicle" [label="є різновидом", style="bold"];
  "gtfs" -> "frequency" [label="містить", ];
  "gtfs" -> "transfer" [label="містить", ];
  "gtfs" -> "shape" [label="містить", ];
  "gtfs" -> "pathway" [label="містить", ];
  "trip" -> "travel_time" [label="містить", ];
  "stop" -> "pathway" [label="містить", ];
  "transmodel" -> "data_standard" [label="є різновидом", style="bold"];
  "transmodel" -> "network" [label="містить", ];
  "transmodel" -> "schedule" [label="містить", ];
  "transmodel" -> "journey" [label="містить", ];
  "transmodel" -> "public_transport_info" [label="містить", ];
  "netex" -> "data_standard" [label="є різновидом", style="bold"];
  "netex" -> "transmodel" [label="залежить від", ];
  "siri" -> "data_standard" [label="є різновидом", style="bold"];
  "siri" -> "transmodel" [label="залежить від", ];
  "its" -> "transport_system" [label="є різновидом", style="bold"];
  "its" -> "traffic" [label="містить", ];
  "its" -> "gps" [label="залежить від", ];
  legend [shape=note, style="filled", fillcolor="#FEF9E7", fontsize=10, label="Легенда:\n• суцільна сіра — ієрархія / асоціація\n• червона пунктирна — крос-зв'язок\n• пунктирна — приклад-екземпляр\n• ромб — екземпляр поняття"];
}